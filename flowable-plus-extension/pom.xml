<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flowable.plus</groupId>
        <artifactId>flowable-plus</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>flowable-plus-extension</artifactId>
    <name>flowable-plus-extension</name>
    <description>Extension module of flowable-plus, providing optional advanced features.</description>

    <dependencies>
        <!-- Core -->
        <dependency>
            <groupId>io.github.flowable.plus</groupId>
            <artifactId>flowable-plus-core</artifactId>
        </dependency>

        <!-- SLF4J（直接使用即显式声明：观测面的结构化日志；版本由父 BOM 管） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- HTTP Client（决策出站传输缝的默认实现；版本由父 BOM 管） -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>

        <!-- Jackson（决策载荷序列化：出域 clamp 的 UTF-8 字节计量口径；直接使用即显式声明，版本由父 BOM 管） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Apache Commons Lang（字符串与集合谓词；直接使用即显式声明，版本由父 BOM 管） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
